{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc --noEmit && esbuild src/index.ts src/modules/jobs/worker.ts src/db/migrate.ts --bundle --platform=node --format=esm --external:better-auth --external:better-auth/* --external:pg --external:hono --external:hono/* --external:@hono/node-server --external:zod --outbase=src --outdir=dist && cp -R src/db/migrations dist/db/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env src/modules/jobs/worker.ts",
    "worker:start": "node --env-file-if-exists=.env dist/modules/jobs/worker.js",
    "db:migrate:production": "node --env-file-if-exists=.env dist/db/migrate.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@workspace/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "esbuild": "^0.25.0"
  },
  "private": true
}
